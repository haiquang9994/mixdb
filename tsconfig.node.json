{
  "compilerOptions": {
    /* Composite, because `tsconfig.json` references it — which is what makes `tsc -b` type-check
       vite.config.ts at all. A referenced project may not disable emit, so the declarations it
       insists on writing are sent somewhere already ignored rather than left beside the config. */
    "composite": true,
    "outDir": "node_modules/.tmp/tsconfig.node",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true
  },
  "include": ["vite.config.ts"]
}
